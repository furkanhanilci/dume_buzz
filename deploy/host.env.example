# The address every client reaches this deployment at.
#
# One value: the relay keys a community by host:port and supports no aliases, so
# a second address is a second workspace rather than a second door. It is kept
# out of the repository because it names a private tailnet — not a credential,
# but not something a public clone needs either.
DUME_BUZZ_HOST=your-relay.example.ts.net
DUME_BUZZ_PAIR_PORT=5443
