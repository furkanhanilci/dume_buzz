# Secrets never enter git. ADR-0007: this tree is on ext4 so 0600 is real.
secrets/
deploy/official-buzz/.env
deploy/official-buzz/.env.*
!deploy/official-buzz/.env.example

# Upstream is a blobless clone, re-fetchable from its recorded ref.
upstream/

# Desktop payload: the official AppImage and its extraction, plus app data.
# 170 MB binary + 292 MB of downloaded voice models — re-fetchable, not source.
deploy/desktop/*.AppImage
deploy/desktop/squashfs-root/
deploy/desktop/appdata/
deploy/desktop/assets.html
deploy/desktop/Dockerfile.xtools
deploy/dume-agents/work/

# npm-installed ACP adapters: re-fetchable, and they drown any credential scan.
deploy/dume-agents/acp/node_modules/
deploy/dume-agents/acp/package-lock.json

# Extracted agent private keys — runtime input, never a tracked file.
deploy/dume-agents/buzz-builtin.json
